INSERT INTO keypoints (segment_id, description) SELECT p0::INTEGER, p1::TEXT FROM (VALUES (39, 'O(log n) represents logarithmic time complexity', 0), (39, 'O(n) represents linear time complexity', 1), (39, 'O(n^2) represents quadratic time complexity', 2)) AS imp_sen(p0, p1, sen_counter) ORDER BY sen_counter RETURNING keypoints.keypoint_id, keypoints.created_at, keypoints.keypoint_id AS keypoint_i